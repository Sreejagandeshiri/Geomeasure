# GeoMeasure Environment Configuration Example

# Application settings
APP_NAME=GeoMeasure
DEBUG=false
LOG_LEVEL=INFO

# Storage
# Relative to project root or absolute directory for uploaded files
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Database
# Default: SQLite file in the project directory
# Example PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/geomeasure
DATABASE_URL=sqlite:///geomeasure.db

# Measurement Projections
# Global equal-area projection for polygon area calculations
EQUAL_AREA_CRS=ESRI:54034

# API Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
